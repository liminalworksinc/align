# Copy to .env (private, gitignored). Used by agent/goal-triage-agent.mjs via scripts/run-plan.sh.
# Never commit real keys. Each endpoint only receives its own credential.
# The agent speaks the Anthropic Messages API format for both options below.
WORLDS_MODEL_PROVIDER=anthropic

# Option A (default, used for the recorded runs): Vercel AI Gateway, Anthropic-compatible Messages endpoint.
# A free-tier gateway blocks Anthropic models, so the recorded runs used openai/gpt-4.1.
# The free tier also rate-limits (HTTP 429); the agent retries model calls with bounded backoff.
WORLDS_MODEL_BASE_URL=https://ai-gateway.vercel.sh
AI_GATEWAY_API_KEY=
WORLDS_MODEL=openai/gpt-4.1

# Option B (alternative): Anthropic direct. Comment out the three Option A lines above,
# then uncomment these and set a Claude model id.
# WORLDS_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=

WORLDS_AGENT_MAX_STEPS=16
WORLDS_AGENT_MAX_TOKENS=1024
WORLDS_AGENT_TIMEOUT_MS=150000
