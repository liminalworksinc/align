'use strict';

const assert = require('node:assert/strict');
const { text } = require('../share_again/text.js');
const { stopped } = require('../share_again/stopped.js');
const { words } = require('../share_again/words.js');

const cases = [
  { id: "generated-text-empty", invoke: text, args: [[]], expected: "" },
  { id: "generated-text-opaque", invoke: text, args: [[" \n",{"device":"__proto__"},"",{"devices_page":"设备😀"},"\n"]], expected: " \n__proto__设备😀\n" },
  { id: "generated-stopped-reader", invoke: stopped, args: [null], expected: "You stopped sharing this session, so a stop or resume can't reach it, and it won't be shared again, even if its machine runs ::align share. To share your work again, start a new session and run ::align share in it." },
  { id: "generated-stopped-deleted", invoke: stopped, args: ["",{"deleted":true}], expected: " stopped sharing this session, so a stop or resume can't reach it. Their account was deleted, so nothing can share it again." },
  { id: "generated-stopped-named", invoke: stopped, args: [" 林\n",{}], expected: " 林\n stopped sharing this session, so a stop or resume can't reach it, and it won't be shared again, even if its machine runs ::align share. To share their work again,  林\n starts a new session and runs ::align share in it." },
  { id: "generated-words-ready-reader", invoke: words, args: [{"name":"Desk","signed_out":false,"has_workspace":true},null], expected: ["Its machine, ",{"device":"Desk"},", has this workspace again: to share it again, run ::align share in the session."] },
  { id: "generated-words-ready-named", invoke: words, args: [{"name":"","signed_out":false,"has_workspace":true},"__proto__"], expected: ["Its machine, ",{"device":""},", has this workspace again: to share it again, __proto__ runs ::align share in the session."] },
  { id: "generated-words-workspace-reader", invoke: words, args: [{"name":"设备\n","signed_out":false,"has_workspace":false},null], expected: ["To share it again now that you are back, give its machine, ",{"device":"设备\n"},", this workspace on your ",{"devices_page":"Devices page"}," (Give this device the workspace), then run ::align share in the session."] },
  { id: "generated-words-workspace-named", invoke: words, args: [{"name":"constructor","signed_out":false,"has_workspace":false},""], expected: ["To share it again now that  is back,  gives its machine, ",{"device":"constructor"},", this workspace on their ",{"devices_page":"Devices page"}," (Give this device the workspace), then runs ::align share in the session."] },
  { id: "generated-words-null-reader", invoke: words, args: [null,null], expected: ["To share it again now that you are back, run align login on that machine (it has signed out of Align) and give it this workspace, then ::align share in the session."] },
  { id: "generated-words-out-named", invoke: words, args: [{"name":"ignored","signed_out":true,"has_workspace":true},"Ada"], expected: ["To share it again now that Ada is back, Ada runs align login on that machine (it has signed out of Align) and gives it this workspace, then ::align share in the session."] },
  { id: "generated-words-out-reader", invoke: words, args: [{"name":"ignored","signed_out":true,"has_workspace":false},null], expected: ["To share it again now that you are back, run align login on that machine (it has signed out of Align) and give it this workspace, then ::align share in the session."] },
  { id: "generated-words-null-named", invoke: words, args: [null,"\n"], expected: ["To share it again now that \n is back, \n runs align login on that machine (it has signed out of Align) and gives it this workspace, then ::align share in the session."] }
];

function freeze(value) {
  if (value !== null && typeof value === 'object') {
    for (const item of Object.values(value)) freeze(item);
    Object.freeze(value);
  }
  return value;
}

function run() {
  const results = [];
  for (const item of cases) {
    const before = JSON.stringify(item.args);
    freeze(item.args);
    assert.deepStrictEqual(item.invoke(...item.args), item.expected, item.id);
    assert.equal(JSON.stringify(item.args), before, item.id + ': input preservation');
    assert.deepStrictEqual(item.invoke(...item.args), item.expected, item.id + ': repeatability');
    results.push({ case_id: item.id, outcome: 'passed' });
  }
  assert.equal(stopped(null, undefined), stopped(null, { deleted: undefined }));
  assert.equal(stopped(null, { deleted: false }), stopped(null));
  assert.deepStrictEqual(words({name:'a',signed_out:true,has_workspace:true}, 'Ada'),
    words({name:'b',signed_out:true,has_workspace:false}, 'Ada'));
  return { schema: 'literate-ai/generated-test-results@1', cases: results };
}

function smoke() {
  return stopped(null);
}

module.exports = { run, smoke };
