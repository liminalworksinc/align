function protocolChecks() {
  const events = [];
  const resources = {};
  const refusal = 0;
  const fns = {
    all: function () { assert.equal(this, undefined); throw new Error('unexpected query'); },
    badRequest: function (message) { assert.equal(this, undefined); events.push(message); return refusal; },
    goalObj: function (goal) { return goal; },
    canReadGoal: function () { return true; },
    need: function (principal, action) { assert.equal(this, undefined); events.push(action); }
  };
  for (const key of ['all', 'badRequest', 'goalObj', 'canReadGoal', 'need']) {
    Object.defineProperty(resources, key, {get() { events.push(key); return fns[key]; }});
  }
  const api = create_spend(resources);
