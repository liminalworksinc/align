'use strict';
const tests = require('./tests/litai_test.js');
function main() {
  if (process.argv.length !== 3) throw new Error('Expected one framework mode');
  if (process.argv[2] === '--litai-test') return tests.run();
  if (process.argv[2] === '--litai-smoke') return tests.smoke();
  throw new Error('This artifact is an importable library');
}
if (require.main === module) {
  try { process.stdout.write(JSON.stringify(main()) + '\n'); }
  catch (error) { process.stderr.write(String(error.stack || error) + '\n'); process.exitCode = 1; }
}
module.exports = {main};
