'use strict';

const fs = require('node:fs');
const path = require('node:path');
const root = path.resolve(__dirname, '..');
const destination = path.resolve(process.argv[2]);
if (destination === root) throw new Error('Artifact must be separate from source');
for (const relative of ['run', 'main.js', 'server_secrets/create_tools.js',
  'server_secrets/package.json', 'tests/litai_test.js']) {
  const target = path.join(destination, relative);
  fs.mkdirSync(path.dirname(target), { recursive: true });
  fs.copyFileSync(path.join(root, relative), target);
}
fs.chmodSync(path.join(destination, 'run'), 0o755);
