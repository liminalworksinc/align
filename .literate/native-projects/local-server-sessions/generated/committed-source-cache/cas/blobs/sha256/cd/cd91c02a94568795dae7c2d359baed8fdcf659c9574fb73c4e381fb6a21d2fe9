#!/usr/bin/env node
'use strict';

const {runTests, smoke} = require('./tests/litai_test.js');
async function main() {
  if (process.argv.length !== 3) throw new Error('Expected exactly one framework mode');
  if (process.argv[2] === '--litai-test') return runTests();
  if (process.argv[2] === '--litai-smoke') return smoke();
  throw new Error('This artifact is an importable library; use server_sessions/create_sessions');
}
main().then(result => { process.stdout.write(JSON.stringify(result) + '\n'); }, error => {
  process.stderr.write(String(error && error.stack || error) + '\n');
  process.exitCode = 1;
});
