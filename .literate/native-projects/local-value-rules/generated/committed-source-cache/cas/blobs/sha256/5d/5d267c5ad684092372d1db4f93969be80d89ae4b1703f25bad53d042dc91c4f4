'use strict';
const {runTests, smoke} = require('./tests/litai_test.js');
function main() {
  if (process.argv.length !== 3) throw new Error('Expected one framework mode argument');
  if (process.argv[2] === '--litai-test') return runTests();
  if (process.argv[2] === '--litai-smoke') return smoke();
  throw new Error('Library component has no product command');
}
if (require.main === module) {
  try { process.stdout.write(JSON.stringify(main()) + '\n'); }
  catch (error) { process.stderr.write(error.message + '\n'); process.exitCode = 1; }
}
module.exports = {main};
