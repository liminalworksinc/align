  ['generated-url-normalize', safe_follow_up_url, [" HTTPS://EXAMPLE.COM:443/a "], "https://example.com/a"],
  ['generated-url-port', safe_follow_up_url, ["https://example.com:444/"], null],
  ['generated-url-mail', safe_follow_up_url, ["mailto:a@b.co?subject=Hello"], "mailto:a@b.co?subject=Hello"],
