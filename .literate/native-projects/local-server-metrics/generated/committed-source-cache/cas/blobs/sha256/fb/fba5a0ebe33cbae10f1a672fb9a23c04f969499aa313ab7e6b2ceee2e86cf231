'use strict';
const fs = require('node:fs');
const path = require('node:path');
const root = path.resolve(__dirname,'..');
const destination = path.resolve(process.argv[2]);
if (destination === root || root.startsWith(destination+path.sep)) throw new Error('Artifact must be separate from source');
for (const relative of ['main.js','server_metrics/package.json','server_metrics/create_metrics.js','tests/litai_test.js']) {
  const target = path.join(destination,relative);
  fs.mkdirSync(path.dirname(target),{recursive:true});
  fs.copyFileSync(path.join(root,relative),target);
}
const launcher = path.join(destination,'run');
fs.writeFileSync(launcher,'#!/usr/bin/env node\n\'use strict\';\ntry { process.stdout.write(JSON.stringify(require(\'./main.js\').main(process.argv.slice(2)))+\'\\n\'); } catch (e) { process.stderr.write(String(e)+\'\\n\'); process.exitCode=1; }\n');
fs.chmodSync(launcher,0o755);
