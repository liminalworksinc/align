async function invoke(method, fixture, ...args) {
  const calls = [];
  const stored = new Set();
  const days = fixture.days || [];
  class Clock extends Date {
    static now() { return 0; }
  }
  const resources = {
    all(sql, ...bindings) { calls.push(['all', sql, ...bindings]); return days; },
    audit(...args) { calls.push(['audit', ...args]); },
    get(sql, ...bindings) {
      calls.push(['get', sql, ...bindings]);
      if (sql === 'SELECT steering FROM v2_workspaces WHERE id = ?') return { steering: fixture.steering };
      assert.equal(sql, 'SELECT device_id, user_id, state FROM v2_sessions WHERE ws_id = ? AND session_key = ?');
      return fixture.sessions && fixture.sessions[bindings[1]];
    },
    run(sql, ...bindings) {
      calls.push(['run', sql, ...bindings]);
      if (sql.startsWith('INSERT OR IGNORE')) {
        const key = JSON.stringify([bindings[0], bindings[1], bindings[6]]);
        if (stored.has(key)) return 0;
        stored.add(key);
      }
      return 1;
    },
    async tx(callback) {
      calls.push(['begin']);
      const result = callback();
      assert.equal(result, undefined);
      calls.push(['commit']);
      return result;
    },
    badRequest(message) { return new Error(message); },
    nowIso() { calls.push(['recorded-time']); return 'recorded-time'; },
    need(...args) { calls.push(['need', ...args]); },
    ID_RE: /^goal-[a-z]+$/,
    SESSION_KEY_RE: /^session-[a-z]+$/,
    readDate() { return Clock; }
  };
  const service = create_steering(resources);
  assert.deepEqual(Object.keys(service), ['workspaceSteering', 'writeSteering', 'ingestSteering', 'steeringCounts']);
  assert.equal(create_steering.length, 1);
  assert.deepEqual(Object.values(service).map(fn => fn.length), [1, 3, 3, 3]);
  const result = await service[method](...args);
  if (method === 'steeringCounts') assert.equal(result.days, days);
  if (method === 'ingestSteering') {
    assert.equal(result.accepted + result.refused.length, args[2].events.length);
    assert.equal(calls.filter(c => c[0] === 'begin').length, 1);
    assert.equal(calls.filter(c => c[0] === 'commit').length, 1);
    assert.equal(calls[0][0], 'need');
    assert.equal(calls[1][0], 'recorded-time');
  }
  if (method === 'writeSteering') {
    const changed = (fixture.steering === 'on' ? 'on' : 'off') !== args[1];
    assert.equal(calls.filter(c => c[0] === 'audit').length, changed ? 1 : 0);
    assert.equal(calls.filter(c => c[0] === 'run').length, changed ? 1 : 0);
  }
  return result;
}
