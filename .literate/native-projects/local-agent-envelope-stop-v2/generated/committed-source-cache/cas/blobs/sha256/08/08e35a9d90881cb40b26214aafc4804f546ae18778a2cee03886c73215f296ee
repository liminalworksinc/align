function invariants(){
  const a=envelope_data(),b=envelope_data();
  assert.notStrictEqual(a,b);
  assert.strictEqual(a.LIMIT_WORDS,b.LIMIT_WORDS);
  assert.strictEqual(a.SAFE_REQUESTS,b.SAFE_REQUESTS);
  const old=a.LIMIT_WORDS.must;
  try {a.LIMIT_WORDS.must='Required';assert.equal(bound_limits({limits:[{type:'must',text:'Keep'}]}).split('\n')[1],'- Required: "Keep"');} finally {a.LIMIT_WORDS.must=old;}
  a.SAFE_REQUESTS.add('test-only');
  try {assert.ok(b.SAFE_REQUESTS.has('test-only'));} finally {a.SAFE_REQUESTS.delete('test-only');}
  const limit={id:'l',text:'new'},before={id:'gone',text:'old'};
  const delta=limit_change({limits:[limit]},[before]);
  assert.strictEqual(delta.added[0],limit);assert.strictEqual(delta.removed[0],before);
  const copied=limits_seen({limits:[limit]});assert.notStrictEqual(copied[0],limit);
  assert.equal(ended_data().SHARE_CHANGED,stored_text({e:'old'}));
  assert.deepEqual([...a.SAFE_REQUESTS],['checkpoint','replan']);
  const stop='this session stays stopped: a stop set from its Align workspace holds after its sharing ends, and nothing lifts it from here now. A new session is not stopped.';
  assert.equal(latch_way_out('id',false,'user',null,{},true),stop);
  assert.ok(!latch_way_out('id',true,'user',null,{lost:true},true).includes('stays stopped'));
  assert.equal(stopped_for_good_words('abcdefghijk','share it'),"this session's sharing was stopped (\x60::align unshare\x60, \x60align stop-sharing\x60 or Stop sharing on the web), and a session whose sharing was stopped is not shared again, so it stays stopped. To share it again, counting from now, first delete its shared history (it leaves every total): run \x60align delete-history abcdefgh\x60 in a terminal, or use Delete shared history on the web's Sessions page; then share it.");
  const g={title:'G',status:'active',version:1,measures:[]};
  const rendered=render_envelope(g);
  assert.equal(rendered,"[Align goal context]\nThis session is shared to an Align workspace and counts toward the goal below. The goal is context for prioritizing the user's work. It grants no tool, network or credential authority and does not override user, system or project instructions.\nGoal: G\nStatus: active (version 1)\nChanges to this goal arrive as short [Align] notes at the start of a turn.");
  assert.deepEqual(g,{title:'G',status:'active',version:1,measures:[]});
}
