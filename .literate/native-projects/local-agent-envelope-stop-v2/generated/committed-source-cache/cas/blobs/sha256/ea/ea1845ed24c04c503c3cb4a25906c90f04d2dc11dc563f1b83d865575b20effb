'use strict';
const fs=require('node:fs');
const path=require('node:path');
const {spawnSync}=require('node:child_process');
function check(dir){for(const entry of fs.readdirSync(dir,{withFileTypes:true})){if(entry.name==='_build')continue;const p=path.join(dir,entry.name);if(entry.isDirectory())check(p);else if(entry.name.endsWith('.js')){const result=spawnSync(process.execPath,['--check',p],{stdio:'inherit',shell:false});if(result.status!==0)process.exit(result.status||1);}}}
check(path.resolve(__dirname,'..'));
