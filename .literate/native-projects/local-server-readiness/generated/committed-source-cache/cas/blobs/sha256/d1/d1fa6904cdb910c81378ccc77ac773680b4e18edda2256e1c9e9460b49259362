'use strict';

const tests = require('./tests/litai_test.js');

async function main(args) {
  if (args.length !== 1) throw new Error('Expected one framework mode');
  if (args[0] === '--litai-test') return tests.run();
  if (args[0] === '--litai-smoke') return tests.smoke();
  throw new Error('This library has no product command-line entrypoint');
}

function dispatch(args) {
  main(args).then(
    (result) => process.stdout.write(JSON.stringify(result) + '\n'),
    (error) => {
      process.stderr.write(String(error && error.stack || error) + '\n');
      process.exitCode = 1;
    }
  );
}

module.exports = { dispatch };
if (require.main === module) dispatch(process.argv.slice(2));
