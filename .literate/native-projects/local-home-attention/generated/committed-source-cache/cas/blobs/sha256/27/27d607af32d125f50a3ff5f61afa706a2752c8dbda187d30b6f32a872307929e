'use strict';
const fs = require('node:fs');
const path = require('node:path');
const root = path.resolve(__dirname, '..');
const destination = path.resolve(process.argv[2] || '_build');
fs.mkdirSync(destination, {recursive: true});
for (const name of ['home_attention', 'tests']) fs.cpSync(path.join(root, name), path.join(destination, name), {recursive: true});
fs.copyFileSync(path.join(root, 'main.js'), path.join(destination, 'run'));
fs.chmodSync(path.join(destination, 'run'), 0o755);
fs.copyFileSync(path.join(root, 'main.js'), path.join(destination, 'main.js'));
