#!/usr/bin/env node
'use strict';
const {runTests, smoke} = require('./tests/litai_test.js');
function main(args) {
  if (args.length !== 1) throw new Error('Expected exactly one framework mode');
  if (args[0] === '--litai-test') return runTests();
  if (args[0] === '--litai-smoke') return smoke();
  throw new Error('This library has no product entrypoint');
}
exports.main = main;
if (require.main === module) {
  try { process.stdout.write(JSON.stringify(main(process.argv.slice(2))) + '\n'); }
  catch (error) { process.stderr.write(String(error.stack || error) + '\n'); process.exitCode = 1; }
}
