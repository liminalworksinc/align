'use strict';

const { runTests, smoke } = require('./tests/litai_test.js');

function main(args) {
  if (args.length !== 1) throw new Error('Expected one framework mode');
  if (args[0] === '--litai-test') return runTests();
  if (args[0] === '--litai-smoke') return smoke();
  throw new Error('This artifact is an importable library');
}

if (require.main === module) {
  try {
    process.stdout.write(JSON.stringify(main(process.argv.slice(2))) + '\n');
  } catch (error) {
    process.stderr.write(String(error?.stack || error) + '\n');
    process.exitCode = 1;
  }
}

module.exports = { main };
