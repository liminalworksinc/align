class HttpError extends Error {
  constructor(status, message, code) { super(message); this.status = status; this.code = code; }
}
class V2Error extends Error {
  constructor(status, code, message, extra = {}) { super(message); this.status = status; this.code = code; this.extra = extra; }
}
function resources(overrides = {}) {
  return { config: () => ({ hosted: false }), hostAllowed: () => true, HttpError, V2Error,
    console: { error() {} }, connection: async () => {}, ready: async () => {},
    clientNet: value => value, getAuth: () => ({ api: { async getSession() { return null; } } }),
    isRecentSignIn: () => true, reauthMessage: what => `Approve ${what}`,
    publicOrigin: () => '', deviceFromAccessToken: () => null, userById: () => null,
