'use strict';
function main(args=process.argv.slice(2)){
 const tests=require('./tests/litai_test.js');
 if(args.length!==1)throw new Error('Expected one framework mode argument');
 const value=args[0]==='--litai-test'?tests.run():args[0]==='--litai-smoke'?tests.smoke():(()=>{throw new Error('This artifact exposes an importable library only');})();
 process.stdout.write(JSON.stringify(value)+'\n');
}
module.exports={main};
if(require.main===module){try{main();}catch(error){process.stderr.write(String(error.message)+'\n');process.exitCode=1;}}
