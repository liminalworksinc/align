'use strict';
const { runTests, smoke } = require('./tests/litai_test.js');

function dispatch(args) {
  if (args.length !== 1) throw new Error('Expected one framework mode');
  if (args[0] === '--litai-test') return runTests();
  if (args[0] === '--litai-smoke') return smoke();
  throw new Error('This library exposes only framework test and smoke modes');
}
if (require.main === module) {
  try {
    process.stdout.write(JSON.stringify(dispatch(process.argv.slice(2))) + '\n');
  } catch (error) {
    process.stderr.write(error.message + '\n');
    process.exitCode = 1;
  }
}
module.exports = { dispatch };
