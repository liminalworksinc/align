'use strict';

function main(args) {
  if (args.length !== 1) throw new Error('Expected one framework mode');
  const tests = require('./tests/litai_test.js');
  if (args[0] === '--litai-test') return tests.runTests();
  if (args[0] === '--litai-smoke') return tests.smoke();
  throw new Error('This library has no product command-line entrypoint');
}

module.exports = { main };

if (require.main === module) {
  try {
    process.stdout.write(JSON.stringify(main(process.argv.slice(2))) + '\n');
  } catch (error) {
    process.stderr.write(error.message + '\n');
    process.exitCode = 1;
  }
}
