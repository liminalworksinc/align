LITAI_LANGUAGE_TOOL ?= node
OBJECT_ROOT ?= ../_build/server-directives
OUT ?= $(OBJECT_ROOT)/run
.PHONY: all test check
all:
	"$(LITAI_LANGUAGE_TOOL)" tools/package.js "$(OUT)"
test:
	"$(LITAI_LANGUAGE_TOOL)" main.js --litai-test
check:
	"$(LITAI_LANGUAGE_TOOL)" --check server_directives/create_directives.js
	"$(LITAI_LANGUAGE_TOOL)" --check tests/litai_test.js
	"$(LITAI_LANGUAGE_TOOL)" --check main.js
	"$(LITAI_LANGUAGE_TOOL)" --check tools/package.js
