#!/usr/bin/env node
'use strict';
const tests = require('./tests/litai_test.js');
async function main() {
  if (process.argv.length !== 3) throw new Error('Expected one framework mode');
  let result;
  if (process.argv[2] === '--litai-test') result = await tests.runTests();
  else if (process.argv[2] === '--litai-smoke') result = tests.smoke();
  else throw new Error('This library has no product entrypoint');
  process.stdout.write(JSON.stringify(result) + '\n');
}
main().catch(error => { process.stderr.write(String(error.stack || error) + '\n'); process.exitCode = 1; });
