'use strict';

const fs = require('node:fs');
const path = require('node:path');
const root = path.resolve(__dirname, '..');
const destination = path.resolve(process.argv[2] || path.join(root, '_build'));
if (destination === root || root.startsWith(destination + path.sep)) {
  throw new Error('Artifact destination must not contain the source root');
}
for (const file of ['main.js', 'tests/litai_test.js', 'spend_rounding/package.json', 'spend_rounding/pico_to_micros.js']) {
  const target = path.join(destination, file);
  fs.mkdirSync(path.dirname(target), { recursive: true });
  fs.copyFileSync(path.join(root, file), target);
}
fs.copyFileSync(path.join(root, 'main.js'), path.join(destination, 'run'));
fs.chmodSync(path.join(destination, 'run'), 0o755);
