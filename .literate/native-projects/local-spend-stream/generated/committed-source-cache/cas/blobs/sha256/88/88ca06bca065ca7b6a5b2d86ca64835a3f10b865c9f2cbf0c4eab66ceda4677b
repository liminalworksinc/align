'use strict';
function cli() {
  const tests = require('./tests/litai_test.js');
  if (process.argv.length !== 3) throw new Error('Expected one framework mode');
  const mode = process.argv[2];
  if (mode === '--litai-test') return tests.run();
  if (mode === '--litai-smoke') return tests.smoke();
  throw new Error('This library exposes importable modules only');
}
module.exports = {cli};
if (require.main === module) {
  try { process.stdout.write(JSON.stringify(cli()) + '\n'); }
  catch (error) { process.stderr.write(String(error.stack || error) + '\n'); process.exitCode = 1; }
}
