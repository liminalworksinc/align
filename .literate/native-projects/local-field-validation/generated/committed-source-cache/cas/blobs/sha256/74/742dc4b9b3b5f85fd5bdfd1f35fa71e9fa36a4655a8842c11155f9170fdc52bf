'use strict';
const tests = require('./tests/litai_test.js');
function main(args = process.argv.slice(2)) {
  if (args.length !== 1) throw new Error('Expected one framework test mode');
  if (args[0] === '--litai-test') return tests.run();
  if (args[0] === '--litai-smoke') return tests.smoke();
  throw new Error('This library has no product entrypoint');
}
module.exports = {main};
if (require.main === module) {
  try { process.stdout.write(JSON.stringify(main()) + '\n'); }
  catch (error) { process.stderr.write(String(error.stack || error) + '\n'); process.exitCode = 1; }
}
