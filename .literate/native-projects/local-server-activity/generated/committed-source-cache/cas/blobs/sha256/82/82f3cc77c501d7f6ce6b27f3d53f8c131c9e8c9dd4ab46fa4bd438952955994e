    const cleanup = f.writes[f.writes.length - 1];
    assert.deepEqual(cleanup, ['DELETE FROM v2_activity WHERE ws_id = ? AND expires_at < ?', 'w', stamp]);
    if (test.id === 'generated-future-equality') {
      assert.deepEqual(f.writes[0], ['INSERT INTO v2_activity (ws_id, session_key, user_id, goal_id, repo_id, kind, path_hash, path, text, at, expires_at)\n         VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)', 'w', 's', 'u', 'g', '0123456789abcdef', 'claim', null, null, null, '2000-01-01T00:05:00.000Z', '2000-01-01T01:05:00.000Z']);
    }
    results.push({ case_id: test.id, outcome: 'passed' });
  }
  await additionalChecks();
