  await assert.rejects(rollback.api.ingestActivity(principal(), device(), { items: [item(stamp, 'edit'), null] }), /each item must be an object/);
  assert.deepEqual(rollback.writes, []);
  const observations = [];
  const row = new Proxy({ seq: 9, goal_id: 'missing', user_id: 'other' }, { get(target, key) { observations.push(key); return target[key]; } });
  const feed = fixture([row, { seq: 10, goal_id: 'missing', user_id: 'other' }]);
  assert.deepEqual(feed.api.activityFor(principal(), 3), { cursor: 10, items: [] });
  assert.deepEqual(observations.slice(0, 2), ['goal_id', 'user_id']);
  assert.deepEqual(feed.effects.filter(e => Array.isArray(e) && e[0] === 'goal'), [['goal', 'w', 'missing']]);
  assert.deepEqual(fixture().api.activityFor(principal(), 21), { cursor: 21, items: [] });
}
async function runTests() {
