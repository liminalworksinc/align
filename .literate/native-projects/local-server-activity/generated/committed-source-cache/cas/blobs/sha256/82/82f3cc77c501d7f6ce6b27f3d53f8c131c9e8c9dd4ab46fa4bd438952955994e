async function additionalChecks() {
  const order = [];
  const f = fixture();
  const keys = ['all','run','tx','badRequest','nowIso','goalObj','goalRow','canReadGoal','openEpoch','sessionRow','need','cleanProse','isBlankText','personName','SESSION_KEY_RE','readDate'];
  const api = create_activity(new Proxy(f.resources, { get(target, key) { order.push(key); return target[key]; } }));
  assert.deepEqual(order, keys);
  assert.deepEqual(Object.keys(api), ['ingestActivity', 'activityFor']);
  assert.equal(create_activity.name, 'create_activity');
  assert.equal(create_activity.length, 1);
  assert.equal(api.ingestActivity.name, 'ingestActivity');
  assert.equal(api.ingestActivity.length, 3);
  assert.equal(api.ingestActivity.constructor.name, 'AsyncFunction');
  assert.equal(api.activityFor.name, 'activityFor');
  assert.equal(api.activityFor.length, 2);
  assert.equal(api.activityFor.constructor.name, 'Function');
  const hashReads = [];
  const valid = item('2000-01-01T00:00:00.000Z', 'edit');
  Object.defineProperty(valid, 'path_hash', { get() { hashReads.push(1); return 'abcdef0123456789'; } });
  await api.ingestActivity(principal(), device(), { items: [valid] });
  assert.equal(hashReads.length, 6);
