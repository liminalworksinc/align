  const resources = {
    all: (...args) => { effects.push(['all', ...args]); return rows; },
    run: (...args) => { writes.push(args); },
    tx: callback => {
      const size = writes.length;
      try { return callback(); } catch (error) { writes.length = size; throw error; }
    },
    badRequest: message => new Error(message),
    nowIso: () => stamp,
    goalObj: row => row,
    goalRow: (ws, id) => { effects.push(['goal', ws, id]); return id === 'missing' ? null : { id }; },
    canReadGoal: (pp, goal) => goal.id === 'visible',
