const cases = [
  {
    id: 'generated-empty',
    args: () => [principal(), device(), { items: [] }],
    expected: { accepted: 0, refused: [], server_time: stamp }
  },
  {
    id: 'generated-future-equality',
    args: () => [principal(), device(), { items: [item('2000-01-01T00:05:00.000Z', 'claim')] }],
    expected: { accepted: 1, refused: [], server_time: stamp }
  },
  {
    id: 'generated-refusal-order',
    args: () => [principal(), device(), { items: [item('2000-01-01T00:05:00.001Z', 'edit'), item('1999-12-30T23:59:59.999Z', 'task')] }],
    expected: { accepted: 0, refused: [{ index: 0, reason: 'clock_skew' }, { index: 1, reason: 'too_old' }], server_time: stamp }
