'use strict';
const tests = require('./tests/litai_test.js');
async function main() {
  if (process.argv[2] === '--litai-test') return tests.runTests();
  if (process.argv[2] === '--litai-smoke') return tests.smoke();
  throw new Error('This library supports only framework test and smoke modes');
}
main().then(value=>process.stdout.write(JSON.stringify(value)+'\n')).catch(error=>{process.stderr.write(String(error.stack || error)+'\n');process.exitCode=1;});
