# Allowlist: nothing goes into the build context unless it is listed below (Sean's PR #3 review, item 2).
# Scripts, tests, docs, the local agent packages and every .env file stay out of the runtime image.
# The operator command, three core modules and qualified settings closure are assembled in the build stage.
# The trust documents (docs/trust, docs/RETENTION.md) enter the build stage only: /privacy and /trust are built from
# them, and the runtime image gets the build output, never the files.
# The generated native inputs, acceptance files and native build adapter enter
# only the build stage. No source cache or verifier is copied to the runtime.
*
!package.json
!package-lock.json
!app
!lib
!public
!proxy.ts
!instrumentation.ts
!next.config.ts
!tsconfig.json
!scripts/align-admin-main.mjs
!scripts/prepare-operator.mjs
!docs/trust
!docs/RETENTION.md
!.native-inputs
!native
!scripts/native-libraries.mjs
lib/native
# Belt and braces inside the allowed folders.
**/.env
**/.env.*
**/*.pem
**/node_modules
**/.next
