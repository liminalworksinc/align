{
  "name": "@liminal/align-agent",
  "version": "0.2.0",
  "private": true,
  "description": "Align local agent: CLI, daemon, Claude Code and Codex hooks, local metering.",
  "type": "module",
  "bin": {
    "align": "dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node scripts/postbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-concurrency=4 test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "7.0.2"
  }
}
