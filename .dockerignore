# Allowlist: nothing goes into the build context unless it is listed below (Sean's PR #3 review, item 2).
# Northstar's data, the Sparta evidence, agent and test scripts, and every .env file stay out of the image.
*
!package.json
!package-lock.json
!app
!components
!lib
!public
!proxy.ts
!instrumentation.ts
!next.config.ts
!tsconfig.json
!scripts/ws-admin.mjs
# Belt and braces inside the allowed folders.
**/.env
**/.env.*
**/*.pem
**/node_modules
**/.next
